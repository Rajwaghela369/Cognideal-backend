# Copy to backend/.env and adjust. All values are optional; the defaults in
# app/core/config.py apply when a key is absent.
APP_NAME=DealPilot API
API_PREFIX=/api
DEBUG=true

# Comma-separated list.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Must use the asyncpg driver (SQLAlchemy async engine).
# Used when running the backend directly on the host (uvicorn outside
# Docker) -- host port 5433 (see docker-compose.yml) to avoid clashing with
# any other local Postgres already bound to 5432. When the backend runs as
# the `backend` compose service instead, docker-compose.yml overrides this
# to point at the `postgres` service by name; Postgres's own credentials
# live in the root .env (see .env.example at the repo root), not here.
# Keep the password below in sync with root .env's POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://dealpilot:change-me@localhost:5433/dealpilot

# --- Embeddings ---
# EMBEDDING_DIM is baked into the document_chunks.embedding column type by the
# migration. Changing it later requires a new column and a re-embed, not just
# an env change.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Object storage ---
# Where the backend talks to MinIO. `localhost:9000` when running uvicorn on
# the host; docker-compose.yml overrides this to `minio:9000` for the
# containerized backend.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dealpilot
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=dealpilot-documents
MINIO_SECURE=false

# The host a presigned preview URL is signed for. This is opened by the
# BROWSER, so it must be reachable from the browser -- never the compose
# service name, which only resolves inside the network.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_REGION=us-east-1

# --- AI layer ---
# Leave AI_ENABLED=false until a key is set: every AI call site checks it, so
# the rest of the API is unaffected by an absent key.
AI_ENABLED=false
GROQ_API_KEY=

# Roles, not sizes (docs/ai/README.md section 7). The challenger is used by the
# eval harness only -- it is Preview tier and several times the primary's price.
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_CHEAP=openai/gpt-oss-20b
GROQ_MODEL_CHALLENGER=qwen/qwen3.8-27b

# json_schema = Groq's Structured Output API (constrained decoding). Fall back
# to json_mode if the installed langchain-groq predates it.
STRUCTURED_OUTPUT_METHOD=json_schema

# Client-side rate-limit ceiling. Groq Developer plan: 250K TPM / 1K RPM.
GROQ_MAX_CONCURRENCY=4
GROQ_TOKENS_PER_MINUTE=250000
GROQ_REQUESTS_PER_MINUTE=1000
