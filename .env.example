# Copy to backend/.env and adjust. All values are optional; the defaults in
# app/core/config.py apply when a key is absent.
APP_NAME=CogniDeal API
API_PREFIX=/api
DEBUG=true
# Console log level for the app's own loggers (API and worker). Unset follows
# DEBUG: DEBUG when true, INFO otherwise. INFO is right for production.
# LOG_LEVEL=INFO

# Comma-separated list.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Paste the connection string exactly as Neon gives it. The app converts it
# for both of its drivers (asyncpg for the API, psycopg for chat memory), so
# `postgresql://`, `sslmode=` and `channel_binding=` are all fine as-is.
# Use the pooled (`-pooler`) host for the running API and worker.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# --- Embeddings ---
# EMBEDDING_DIM is baked into the document_chunks.embedding column type by the
# migration. Changing it later requires a new column and a re-embed, not just
# an env change.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Object storage ---
# S3-compatible storage (Neon). Map Neon's values as:
#   AWS_ENDPOINT_URL_S3   -> S3_ENDPOINT  (full https:// URL is fine)
#   AWS_ACCESS_KEY_ID     -> S3_ACCESS_KEY
#   AWS_SECRET_ACCESS_KEY -> S3_SECRET_KEY
#   AWS_REGION            -> S3_REGION
# Create the bucket in the Neon console first.
S3_ENDPOINT=https://<id>.storage.<region>.aws.neon.tech
S3_ACCESS_KEY=<access-key-id>
S3_SECRET_KEY=<secret-access-key>
S3_REGION=eu-central-1
S3_BUCKET=<bucket-name>

# Only needed for a bare host:port endpoint with no scheme.
# S3_SECURE=true

# The host a presigned preview URL is signed for -- opened by the BROWSER.
# Defaults to S3_ENDPOINT; set it only if the browser must use a different host.
# S3_PUBLIC_ENDPOINT=

# --- AI layer ---
# Leave AI_ENABLED=false until a key is set: every AI call site checks it, so
# the rest of the API is unaffected by an absent key.
AI_ENABLED=false
OPENAI_API_KEY=

# Roles, not sizes (docs/ai/README.md section 7). Primary does extraction,
# validation and detection; cheap does titles and name tiebreaks. The
# challenger is used by the eval harness only.
AI_MODEL_PRIMARY=gpt-4o
AI_MODEL_CHEAP=gpt-4o-mini
AI_MODEL_CHALLENGER=gpt-4o

# json_schema = OpenAI Structured Outputs, sent with strict (constrained
# decoding). function_calling is the fallback for a model without it.
STRUCTURED_OUTPUT_METHOD=json_schema

# Event-driven deal analysis. Relevant writes wait for a quiet minute, but a
# continuous edit stream is forced through after ten minutes. The same worker
# sweeps clean deals daily so clock-only risks and missed events self-heal.
ANALYSIS_DEBOUNCE_SECONDS=60
ANALYSIS_MAX_DEBOUNCE_SECONDS=600
ANALYSIS_SWEEP_HOURS=24
# A crashed analysis run is retried with exponential backoff (30s, 60s, ...)
# and given up on after this many attempts, instead of being re-run at once.
WORKER_MAX_ATTEMPTS=3
# Run the analysis worker inside the API process. Set true where the worker
# cannot be its own service (Render free plan). Without a worker running
# somewhere, queued meeting analysis never starts.
EMBEDDED_WORKER=false

# Chat assistant: questions per day across everyone (0 = unlimited), reset
# at midnight in this timezone. Analysis, briefs and risk detection are not
# counted.
CHAT_DAILY_MESSAGE_LIMIT=200
CHAT_LIMIT_TIMEZONE=Europe/Berlin
WORKER_RETRY_BACKOFF_SECONDS=30
GONE_QUIET_DAYS=21
# Set only around bulk imports; deterministic tiers remain enabled.
ANALYSIS_TIER2_SUPPRESSED=false

# Client-side rate-limit ceiling. MUST match your account's tier or the
# governor does nothing. Defaults are gpt-4o at OpenAI Tier 1; see
# platform.openai.com -> Settings -> Limits for yours.
AI_MAX_CONCURRENCY=4
AI_TOKENS_PER_MINUTE=30000
AI_REQUESTS_PER_MINUTE=500
